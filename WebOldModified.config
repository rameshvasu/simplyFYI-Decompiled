<?xml version="1.0"?>
<configuration> 
  <appSettings>
    <add key="SIMPLYFYI_ConnectionString" value="Provider=SQLOLEDB;SERVER=mssql01.anaxanet.com;DATABASE=SIMPLYFY_SIMPLYFYI;Uid=simplyfy_simplyfyi;Pwd=S1mplyfy1;"/>
    <add key="OptOutPageUrl" value="http://payments.simplyfyi.com/OptOut.aspx"/>  
    <add key="InvitePageUrl" value="http://payments.simplyfyi.com/Invite.aspx"/>   
    <add key="FreeNewAccountTopupCount" value="100" />    
    <add key="TwilioRedirectUrl" value="http://www.simplyfyiapps.com/voicegrammar/reminder.aspx"/>
    <add key="AdministratorEmail" value="ramesh@rameshinnovation.com"/>
    <add key="DefaultSenderFromAddressForEmail" value="fyi@simplyfyi.com"/>
    <add key="DefaultSenderFromNameForEmail" value="SIMPLYFYI"/>
    <add key="DefaultSenderFromAddressForPhone" value="9164096551"/>
    <add key="DefaultSenderFromNameForPhone" value="9164096551"/>
    <add key="DefaultSenderFromAddressForSMS" value="9164096551"/>
    <add key="DefaultSenderFromNameForSMS" value="simplyfyi"/>
    <add key="EmailRateMultiplier" value="3"/>
    <add key="SMSRateMultiplier" value="5"/>
    <add key="PhoneRateMultiplier" value="7"/>
    <add key="EditGridCallbackUrl" value="http://payments.simplyfyi.com/EditGridLoginGatewayCallback.aspx"/>
    <!--<add key="EditGridCallbackUrl" value="http://192.168.1.7/simplyfyiexpress/EditGridLoginGatewayCallback.aspx"/>-->
    <add key="SpamRecordLimt" value="3000"/>
    <add key="LogFile" value="C:\Domains\simplyfyi.com\services"/>
    <add key="HideContactAddressForThisAccount" value="1000" />

<!-- NEW -->
    <add key="EmailVerificationPageUrl" value="http://payments.simplyfyi.com/VerifyEmail.aspx"/>
    <add key="AppBazaarSourceMetaIDsToClone" value="184,205,186"/>
    <add key="JanrainTokenUrl" value="http://8.8.247.151/payments/janrain.aspx"/>
    <add key="IPNPayPalEmailRateMultiplier" value="3"/>
    <add key="PayPalIPNUrl" value="http://ipnhandlers.simplyfyi.com/paypal/paypalipnhandler.aspx"/>
    <add key="CommentBoxPageHomeUrl" value="http://payments.simplyfyi.com"/>
    <add key="PayPalIPNHandlerTestStubUrl" value="http://payments.simplyfyi.com/PayPalIPNHandlerTestStub.aspx"/>

    <add key="PayPayApiLiveMode" value="true"/>
    <add key="PayPayApiLiveModeSelfTest" value="true"/>
    <add key="AdminAccountEmail" value="ramesh@rameshinnovation.com"/>
    <add key="CallbackForProcessPayPalApiPermission" value="http://payments.simplyfyi.com/ProcessPayPalApiPermission.aspx"/>

    <add key="PayPayApiLiveModeForBillingAgreement" value="true"/>
    <add key="PayPalBillingAgreementReturnUrl" value="http://payments.simplyfyi.com/TopupAutoSuccess.aspx"/>
    <add key="PayPalBillingAgreementCancelUrl" value="http://payments.simplyfyi.com/Topup.aspx"/>
